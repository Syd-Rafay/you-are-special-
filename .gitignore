```gitignore
# Python compiled files
*.pyc
__pycache__/

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Tests
.test*
.pytest_cache/
.coverage
coverage/
htmlcov/
```
# Local files
.DS_Store
**/.DS_Store
test_data/

# Local development environment
.venv/

# Generated Python packaging metadata
*.egg-info/
